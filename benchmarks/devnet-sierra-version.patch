+
+/// The Sierra version a class was compiled to, read from the header of its Sierra program
+/// (not `contract_class_version`, which is the class format version).
+fn sierra_version_of_class(class: &SierraContractClass) -> Result<SierraVersion, Error> {
+    let program: Vec<Felt> =
+        class.sierra_program.iter().take(3).map(|f| Felt::from(f.value.clone())).collect();
+    SierraVersion::extract_from_program(&program).map_err(|e| {
+        Error::ConversionError(ConversionError::InvalidInternalStructure(e.to_string()))
+    })
+}
