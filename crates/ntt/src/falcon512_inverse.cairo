//! Falcon-512 inverse NTT computed with the generated forward transform.
//!
//! The forward transform evaluates a polynomial at the 512 roots of `x^512 + 1` in the
//! Falcon evaluation order, `NTT(f)[i] = f(r_i)`. Every root is an odd power of one
//! primitive 1024-th root of unity `psi`, `r_i = psi^(2 m_i + 1)`, so interpolation at
//! those roots is a twisted cyclic transform that the same forward graph computes:
//!
//! ```text
//! g_k = NTT(f)[pos(k)] * psi^-k                         k = 0..511
//! f_j = n^-1 * psi^-j * NTT(g)[pos((n - j) mod n)]      j = 0..511
//! ```
//!
//! where `pos(k)` is the evaluation-order position of the root `psi^(2k + 1)`. The
//! position and twist tables are generated by `scripts/gen_ntt_tables.py`, which also
//! proves this construction equal to the recursive inverse transform and to schoolbook
//! negacyclic multiplication. Each twist product is reduced exactly once, so the forward
//! graph always receives canonical coefficients and every output lies in `[0, q)`. Inputs
//! may be any `u16` values; they are read modulo q.

use corelib_imports::bounded_int::bounded_int::mul;
use corelib_imports::bounded_int::{
    BoundedInt, DivRemHelper, MulHelper, UnitInt, bounded_int_div_rem, upcast,
};
use crate::falcon512_fast::ntt_falcon512_fast_u16_unchecked;
use crate::falcon512_inverse_tables::{
    INV_IN_POSITION, INV_IN_TWIST, INV_OUT_POSITION, INV_OUT_TWIST,
};

/// Any `u16` value as a bounded integer.
type U16Value = BoundedInt<0, 65535>;
/// Product of two `u16` values: at most `(2^16 - 1)^2`.
type U16Product = BoundedInt<0, 4294836225>;
/// Product of three `u16` values: at most `(2^16 - 1)^3`.
type U16TripleProduct = BoundedInt<0, 281462092005375>;
type Falcon512Q = UnitInt<12289>;
type Falcon512Zq = BoundedInt<0, 12288>;

const FALCON512_Q_NZ: NonZero<Falcon512Q> = 12289;

impl U16ValueMulImpl of MulHelper<U16Value, U16Value> {
    type Result = U16Product;
}

impl U16ProductMulImpl of MulHelper<U16Product, U16Value> {
    type Result = U16TripleProduct;
}

impl U16ProductDivRemImpl of DivRemHelper<U16Product, Falcon512Q> {
    type DivT = BoundedInt<0, 349486>;
    type RemT = Falcon512Zq;
}

impl U16TripleProductDivRemImpl of DivRemHelper<U16TripleProduct, Falcon512Q> {
    type DivT = BoundedInt<0, 22903579787>;
    type RemT = Falcon512Zq;
}

/// `a * b mod q` for any `u16` operands.
#[inline(always)]
fn mul_mod_q(a: u16, b: u16) -> u16 {
    let product: U16Product = mul(upcast::<u16, U16Value>(a), upcast::<u16, U16Value>(b));
    let (_, r) = bounded_int_div_rem(product, FALCON512_Q_NZ);
    upcast(r)
}

/// `a * b * c mod q` for any `u16` operands.
#[inline(always)]
fn mul3_mod_q(a: u16, b: u16, c: u16) -> u16 {
    let ab: U16Product = mul(upcast::<u16, U16Value>(a), upcast::<u16, U16Value>(b));
    let abc: U16TripleProduct = mul(ab, upcast::<u16, U16Value>(c));
    let (_, r) = bounded_int_div_rem(abc, FALCON512_Q_NZ);
    upcast(r)
}

/// Inverse Falcon-512 NTT.
///
/// `f_ntt` holds 512 values in the Falcon evaluation order (the output order of
/// [`ntt_falcon512_fast_u16_unchecked`]), read modulo q. Returns the polynomial's 512
/// coefficients in natural order, reduced to `[0, q)`. Panics unless `f_ntt` has exactly
/// 512 entries.
pub fn intt_falcon512_fast_u16(f_ntt: Span<u16>) -> Array<u16> {
    assert(f_ntt.len() == 512, 'fast INTT: bad length');
    let mut g: Array<u16> = array![];
    let mut positions = INV_IN_POSITION.span();
    let mut twists = INV_IN_TWIST.span();
    // 16-way unrolled (512 = 16 * 32, no remainder).
    while let Some(position_chunk) = positions.multi_pop_front::<16>() {
        let [p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15] =
            (*position_chunk)
            .unbox();
        let twist_chunk = twists.multi_pop_front::<16>().unwrap();
        let [t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15] = (*twist_chunk)
            .unbox();
        g.append(mul_mod_q(*f_ntt.at(p0.into()), t0));
        g.append(mul_mod_q(*f_ntt.at(p1.into()), t1));
        g.append(mul_mod_q(*f_ntt.at(p2.into()), t2));
        g.append(mul_mod_q(*f_ntt.at(p3.into()), t3));
        g.append(mul_mod_q(*f_ntt.at(p4.into()), t4));
        g.append(mul_mod_q(*f_ntt.at(p5.into()), t5));
        g.append(mul_mod_q(*f_ntt.at(p6.into()), t6));
        g.append(mul_mod_q(*f_ntt.at(p7.into()), t7));
        g.append(mul_mod_q(*f_ntt.at(p8.into()), t8));
        g.append(mul_mod_q(*f_ntt.at(p9.into()), t9));
        g.append(mul_mod_q(*f_ntt.at(p10.into()), t10));
        g.append(mul_mod_q(*f_ntt.at(p11.into()), t11));
        g.append(mul_mod_q(*f_ntt.at(p12.into()), t12));
        g.append(mul_mod_q(*f_ntt.at(p13.into()), t13));
        g.append(mul_mod_q(*f_ntt.at(p14.into()), t14));
        g.append(mul_mod_q(*f_ntt.at(p15.into()), t15));
    }
    untwist_output(ntt_falcon512_fast_u16_unchecked(g.span()).span())
}

/// Negacyclic product from evaluations: `INTT(a_ntt ∘ b_ntt)`.
///
/// `a_ntt` and `b_ntt` hold 512 values each in the Falcon evaluation order, read modulo q.
/// Returns the coefficients of `a * b mod (q, x^512 + 1)` in natural order, reduced to
/// `[0, q)`. The pointwise product is fused into the input twist, so each input
/// coefficient is reduced once. Panics unless both inputs have exactly 512 entries.
pub fn intt_product_falcon512_fast_u16(a_ntt: Span<u16>, b_ntt: Span<u16>) -> Array<u16> {
    assert(a_ntt.len() == 512, 'fast INTT: bad length');
    assert(b_ntt.len() == 512, 'fast INTT: bad length');
    let mut g: Array<u16> = array![];
    let mut positions = INV_IN_POSITION.span();
    let mut twists = INV_IN_TWIST.span();
    // 16-way unrolled (512 = 16 * 32, no remainder).
    while let Some(position_chunk) = positions.multi_pop_front::<16>() {
        let [p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15] =
            (*position_chunk)
            .unbox();
        let twist_chunk = twists.multi_pop_front::<16>().unwrap();
        let [t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15] = (*twist_chunk)
            .unbox();
        let i0: u32 = p0.into();
        g.append(mul3_mod_q(*a_ntt.at(i0), *b_ntt.at(i0), t0));
        let i1: u32 = p1.into();
        g.append(mul3_mod_q(*a_ntt.at(i1), *b_ntt.at(i1), t1));
        let i2: u32 = p2.into();
        g.append(mul3_mod_q(*a_ntt.at(i2), *b_ntt.at(i2), t2));
        let i3: u32 = p3.into();
        g.append(mul3_mod_q(*a_ntt.at(i3), *b_ntt.at(i3), t3));
        let i4: u32 = p4.into();
        g.append(mul3_mod_q(*a_ntt.at(i4), *b_ntt.at(i4), t4));
        let i5: u32 = p5.into();
        g.append(mul3_mod_q(*a_ntt.at(i5), *b_ntt.at(i5), t5));
        let i6: u32 = p6.into();
        g.append(mul3_mod_q(*a_ntt.at(i6), *b_ntt.at(i6), t6));
        let i7: u32 = p7.into();
        g.append(mul3_mod_q(*a_ntt.at(i7), *b_ntt.at(i7), t7));
        let i8: u32 = p8.into();
        g.append(mul3_mod_q(*a_ntt.at(i8), *b_ntt.at(i8), t8));
        let i9: u32 = p9.into();
        g.append(mul3_mod_q(*a_ntt.at(i9), *b_ntt.at(i9), t9));
        let i10: u32 = p10.into();
        g.append(mul3_mod_q(*a_ntt.at(i10), *b_ntt.at(i10), t10));
        let i11: u32 = p11.into();
        g.append(mul3_mod_q(*a_ntt.at(i11), *b_ntt.at(i11), t11));
        let i12: u32 = p12.into();
        g.append(mul3_mod_q(*a_ntt.at(i12), *b_ntt.at(i12), t12));
        let i13: u32 = p13.into();
        g.append(mul3_mod_q(*a_ntt.at(i13), *b_ntt.at(i13), t13));
        let i14: u32 = p14.into();
        g.append(mul3_mod_q(*a_ntt.at(i14), *b_ntt.at(i14), t14));
        let i15: u32 = p15.into();
        g.append(mul3_mod_q(*a_ntt.at(i15), *b_ntt.at(i15), t15));
    }
    untwist_output(ntt_falcon512_fast_u16_unchecked(g.span()).span())
}

/// Reads the forward transform of the twisted input back in natural coefficient order and
/// applies the output twist `n^-1 * psi^-j`.
fn untwist_output(transformed: Span<u16>) -> Array<u16> {
    let mut out: Array<u16> = array![];
    let mut positions = INV_OUT_POSITION.span();
    let mut twists = INV_OUT_TWIST.span();
    // 16-way unrolled (512 = 16 * 32, no remainder).
    while let Some(position_chunk) = positions.multi_pop_front::<16>() {
        let [p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15] =
            (*position_chunk)
            .unbox();
        let twist_chunk = twists.multi_pop_front::<16>().unwrap();
        let [t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15] = (*twist_chunk)
            .unbox();
        out.append(mul_mod_q(*transformed.at(p0.into()), t0));
        out.append(mul_mod_q(*transformed.at(p1.into()), t1));
        out.append(mul_mod_q(*transformed.at(p2.into()), t2));
        out.append(mul_mod_q(*transformed.at(p3.into()), t3));
        out.append(mul_mod_q(*transformed.at(p4.into()), t4));
        out.append(mul_mod_q(*transformed.at(p5.into()), t5));
        out.append(mul_mod_q(*transformed.at(p6.into()), t6));
        out.append(mul_mod_q(*transformed.at(p7.into()), t7));
        out.append(mul_mod_q(*transformed.at(p8.into()), t8));
        out.append(mul_mod_q(*transformed.at(p9.into()), t9));
        out.append(mul_mod_q(*transformed.at(p10.into()), t10));
        out.append(mul_mod_q(*transformed.at(p11.into()), t11));
        out.append(mul_mod_q(*transformed.at(p12.into()), t12));
        out.append(mul_mod_q(*transformed.at(p13.into()), t13));
        out.append(mul_mod_q(*transformed.at(p14.into()), t14));
        out.append(mul_mod_q(*transformed.at(p15.into()), t15));
    }
    out
}
